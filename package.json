{
  "name": "dsi-auth",
  "version": "1.0.0",
  "description": "Official SSO Authentication SDK for DEV SEC IT Accounts (https://accounts.devsecit.com)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "devsecit",
    "sso",
    "auth",
    "oauth2",
    "authentication",
    "identity",
    "accounts.devsecit.com"
  ],
  "homepage": "https://accounts.devsecit.com",
  "author": "DEV SEC IT <support@devsecit.com>",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
